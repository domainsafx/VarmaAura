# SMTP settings used by app/api/book, app/api/visit and app/api/enquiry
# to email new booking requests, visit requests and private enquiries.
#
# Copy this file to .env.local (for local dev) and fill in real values,
# or set the same variables in your hosting provider's environment
# settings (Vercel/Netlify project settings -> Environment Variables).

# Your SMTP server host, e.g. smtp.gmail.com, smtp.zoho.com, smtp.office365.com
SMTP_HOST=smtp.gmail.com

# 587 for STARTTLS (most common), 465 for SSL
SMTP_PORT=587

# true if using port 465, false/omit for port 587
SMTP_SECURE=false

# SMTP account credentials.
# If using Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that here (a normal
# Gmail password will not work).
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional: the "From" address shown to recipients. Defaults to SMTP_USER
# if not set. Many providers require this to match/be verified for SMTP_USER.
MAIL_FROM=varmaauraa@gmail.com

# Where booking/visit/enquiry notifications should be delivered.
# Can be the same as SMTP_USER, or any other inbox your team checks.
MAIL_TO=varmaauraa@gmail.com
